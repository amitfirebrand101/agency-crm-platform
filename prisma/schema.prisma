generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AgencyRole {
  OWNER
  ADMIN
  MEMBER
  READ_ONLY
}

enum SubAccountRole {
  ADMIN
  SALES
  SUPPORT
  READ_ONLY
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
  URL
}

enum ContactStatus {
  LEAD
  CUSTOMER
  INACTIVE
}

enum ConversationChannel {
  SMS
  EMAIL
  CALL
  VOICEMAIL
  INTERNAL_NOTE
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  INVITE
}

enum AutomationRunStatus {
  QUEUED
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}

enum AutomationVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AutomationEnrollmentStatus {
  ACTIVE
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}

enum AutomationWebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id                    String                 @id @db.Uuid
  name                  String?
  email                 String                 @unique
  imageUrl              String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  agencyMemberships     AgencyMembership[]
  subAccountMemberships SubAccountMembership[]
  assignedContacts      Contact[]              @relation("AssignedContacts")
  auditLogs             AuditLog[]
}

model Agency {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  slug         String             @unique
  timezone     String             @default("America/New_York")
  currency     String             @default("USD")
  country      String             @default("US")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  members      AgencyMembership[]
  subAccounts  SubAccount[]
  tags         Tag[]
  customFields CustomField[]
  auditLogs    AuditLog[]
  Contact      Contact[]
}

model AgencyMembership {
  id        String     @id @default(uuid()) @db.Uuid
  agencyId  String     @db.Uuid
  userId    String     @db.Uuid
  role      AgencyRole @default(MEMBER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  agency    Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
  @@index([userId])
}

model SubAccount {
  id            String                 @id @default(uuid()) @db.Uuid
  agencyId      String                 @db.Uuid
  name          String
  slug          String
  timezone      String                 @default("America/New_York")
  addressLine1  String?
  city          String?
  region        String?
  country       String?                @default("US")
  postalCode    String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  agency        Agency                 @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  members       SubAccountMembership[]
  contacts      Contact[]
  tags          Tag[]
  customFields  CustomField[]
  pipelines     Pipeline[]
  conversations Conversation[]
  calendars     Calendar[]
  automations   Automation[]
  sites         Site[]
  sitePages     SitePage[]
  funnels       Funnel[]
  siteForms     SiteForm[]
  surveys       Survey[]
  blogPosts     BlogPost[]
  campaigns     MarketingCampaign[]
  phoneNumbers  PhoneNumber[]

  @@unique([agencyId, slug])
  @@index([agencyId])
}

model SubAccountMembership {
  id           String         @id @default(uuid()) @db.Uuid
  subAccountId String         @db.Uuid
  userId       String         @db.Uuid
  role         SubAccountRole @default(SALES)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  subAccount   SubAccount     @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subAccountId, userId])
  @@index([userId])
}

model Contact {
  id             String             @id @default(uuid()) @db.Uuid
  agencyId       String             @db.Uuid
  subAccountId   String             @db.Uuid
  assignedUserId String?            @db.Uuid
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  companyName    String?
  status         ContactStatus      @default(LEAD)
  source         String?
  timezone       String?
  addressLine1   String?
  city           String?
  region         String?
  country        String?
  postalCode     String?
  emailOptOut    Boolean            @default(false)
  smsOptOut      Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  agency         Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  subAccount     SubAccount         @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  assignedUser   User?              @relation("AssignedContacts", fields: [assignedUserId], references: [id], onDelete: SetNull)
  tags           ContactTag[]
  customValues   CustomFieldValue[]
  opportunities  Opportunity[]
  conversations  Conversation[]
  appointments   Appointment[]

  @@index([agencyId, subAccountId])
  @@index([subAccountId, email])
  @@index([subAccountId, phone])
}

model Tag {
  id           String       @id @default(uuid()) @db.Uuid
  agencyId     String       @db.Uuid
  subAccountId String?      @db.Uuid
  name         String
  color        String       @default("#0e7490")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  agency       Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  subAccount   SubAccount?  @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  contacts     ContactTag[]

  @@unique([agencyId, subAccountId, name])
  @@index([subAccountId])
}

model ContactTag {
  contactId String   @db.Uuid
  tagId     String   @db.Uuid
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model CustomField {
  id           String             @id @default(uuid()) @db.Uuid
  agencyId     String             @db.Uuid
  subAccountId String?            @db.Uuid
  name         String
  key          String
  type         FieldType          @default(TEXT)
  options      Json?
  required     Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  agency       Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  subAccount   SubAccount?        @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  values       CustomFieldValue[]

  @@unique([agencyId, subAccountId, key])
  @@index([subAccountId])
}

model CustomFieldValue {
  id            String      @id @default(uuid()) @db.Uuid
  contactId     String      @db.Uuid
  customFieldId String      @db.Uuid
  value         Json
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  contact       Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([contactId, customFieldId])
}

model Pipeline {
  id           String          @id @default(uuid()) @db.Uuid
  agencyId     String          @db.Uuid
  subAccountId String          @db.Uuid
  name         String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  subAccount   SubAccount      @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]

  @@index([agencyId, subAccountId])
}

model PipelineStage {
  id            String        @id @default(uuid()) @db.Uuid
  pipelineId    String        @db.Uuid
  name          String
  position      Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([pipelineId, position])
}

model Opportunity {
  id           String            @id @default(uuid()) @db.Uuid
  agencyId     String            @db.Uuid
  subAccountId String            @db.Uuid
  stageId      String            @db.Uuid
  contactId    String?           @db.Uuid
  name         String
  valueCents   Int               @default(0)
  status       OpportunityStatus @default(OPEN)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  stage        PipelineStage     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contact      Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([agencyId, subAccountId])
}

model Conversation {
  id           String              @id @default(uuid()) @db.Uuid
  agencyId     String              @db.Uuid
  subAccountId String              @db.Uuid
  contactId    String?             @db.Uuid
  channel      ConversationChannel
  status       ConversationStatus  @default(OPEN)
  subject      String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  subAccount   SubAccount          @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  contact      Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages     Message[]

  @@index([agencyId, subAccountId, status])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  body           String
  direction      String
  providerId     String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Calendar {
  id           String        @id @default(uuid()) @db.Uuid
  agencyId     String        @db.Uuid
  subAccountId String        @db.Uuid
  name         String
  timezone     String        @default("America/New_York")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  subAccount   SubAccount    @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([agencyId, subAccountId])
}

model Appointment {
  id         String   @id @default(uuid()) @db.Uuid
  calendarId String   @db.Uuid
  contactId  String?  @db.Uuid
  startsAt   DateTime
  endsAt     DateTime
  title      String
  status     String   @default("scheduled")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
}

model Automation {
  id                String                      @id @default(uuid()) @db.Uuid
  agencyId          String                      @db.Uuid
  subAccountId      String                      @db.Uuid
  name              String
  status            String                      @default("draft")
  definition        Json                        @default("{}")
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  subAccount        SubAccount                  @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  runs              AutomationRun[]
  versions          AutomationVersion[]
  enrollments       AutomationEnrollment[]
  webhookDeliveries AutomationWebhookDelivery[]

  @@index([agencyId, subAccountId])
}

model AutomationVersion {
  id            String                  @id @default(uuid()) @db.Uuid
  automationId  String                  @db.Uuid
  agencyId      String                  @db.Uuid
  subAccountId  String                  @db.Uuid
  versionNumber Int
  name          String
  definition    Json
  status        AutomationVersionStatus @default(DRAFT)
  createdById   String?                 @db.Uuid
  createdAt     DateTime                @default(now())
  publishedAt   DateTime?
  automation    Automation              @relation(fields: [automationId], references: [id], onDelete: Cascade)
  enrollments   AutomationEnrollment[]
  runs          AutomationRun[]

  @@unique([automationId, versionNumber])
  @@index([agencyId, subAccountId])
  @@index([automationId, status])
}

model AutomationEnrollment {
  id             String                     @id @default(uuid()) @db.Uuid
  automationId   String                     @db.Uuid
  versionId      String                     @db.Uuid
  agencyId       String                     @db.Uuid
  subAccountId   String                     @db.Uuid
  contactId      String?                    @db.Uuid
  eventKey       String
  triggerType    String
  status         AutomationEnrollmentStatus @default(ACTIVE)
  currentStepId  String?
  context        Json                       @default("{}")
  idempotencyKey String
  resumeAt       DateTime?
  startedAt      DateTime                   @default(now())
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  automation     Automation                 @relation(fields: [automationId], references: [id], onDelete: Cascade)
  version        AutomationVersion          @relation(fields: [versionId], references: [id], onDelete: Cascade)
  runs           AutomationRun[]

  @@unique([idempotencyKey, subAccountId])
  @@index([agencyId, subAccountId])
  @@index([automationId, status])
  @@index([subAccountId, contactId])
  @@index([status, resumeAt])
}

model AutomationRun {
  id           String                @id @default(uuid()) @db.Uuid
  enrollmentId String?               @db.Uuid
  automationId String                @db.Uuid
  versionId    String?               @db.Uuid
  agencyId     String                @db.Uuid
  subAccountId String                @db.Uuid
  contactId    String?               @db.Uuid
  status       AutomationRunStatus   @default(RUNNING)
  triggerType  String
  payload      Json?
  startedAt    DateTime              @default(now())
  completedAt  DateTime?
  error        String?
  enrollment   AutomationEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  version      AutomationVersion?    @relation(fields: [versionId], references: [id], onDelete: SetNull)
  automation   Automation            @relation(fields: [automationId], references: [id], onDelete: Cascade)
  stepRuns     AutomationStepRun[]

  @@index([automationId])
  @@index([agencyId, subAccountId, startedAt])
  @@index([enrollmentId])
}

model AutomationStepRun {
  id           String        @id @default(uuid()) @db.Uuid
  runId        String        @db.Uuid
  enrollmentId String?       @db.Uuid
  automationId String?       @db.Uuid
  agencyId     String?       @db.Uuid
  subAccountId String?       @db.Uuid
  stepId       String
  stepType     String
  stepName     String?
  status       String
  input        Json          @default("{}")
  output       Json?
  error        Json?
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime      @default(now())
  run          AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([enrollmentId])
}

model AutomationEvent {
  id             String   @id @default(uuid()) @db.Uuid
  agencyId       String   @db.Uuid
  subAccountId   String   @db.Uuid
  type           String
  source         String
  contactId      String?  @db.Uuid
  payload        Json
  idempotencyKey String?
  createdAt      DateTime @default(now())

  @@index([agencyId, subAccountId, type])
  @@index([subAccountId, contactId])
  @@index([idempotencyKey])
}

model AutomationWebhookDelivery {
  id           String                          @id @default(uuid()) @db.Uuid
  agencyId     String                          @db.Uuid
  subAccountId String                          @db.Uuid
  automationId String                          @db.Uuid
  runId        String?                         @db.Uuid
  stepRunId    String?                         @db.Uuid
  url          String
  method       String                          @default("POST")
  status       AutomationWebhookDeliveryStatus @default(PENDING)
  request      Json
  response     Json?
  error        Json?
  attempt      Int                             @default(1)
  createdAt    DateTime                        @default(now())
  updatedAt    DateTime                        @updatedAt
  automation   Automation                      @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([agencyId, subAccountId])
  @@index([automationId])
  @@index([runId])
}

model Site {
  id           String     @id @default(uuid()) @db.Uuid
  agencyId     String     @db.Uuid
  subAccountId String     @db.Uuid
  name         String
  domain       String?
  status       String     @default("draft")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  subAccount   SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  pages        SitePage[]

  @@index([agencyId, subAccountId])
}

model SitePage {
  id             String            @id @default(uuid()) @db.Uuid
  siteId         String            @db.Uuid
  subAccountId   String            @db.Uuid
  agencyId       String            @db.Uuid
  slug           String
  title          String
  status         String            @default("draft")
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  site           Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  subAccount     SubAccount        @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  versions       SitePageVersion[]

  @@unique([siteId, slug])
  @@index([siteId])
  @@index([subAccountId])
}

model SitePageVersion {
  id            String    @id @default(uuid()) @db.Uuid
  pageId        String    @db.Uuid
  versionNumber Int
  status        String    @default("draft")
  schema        Json
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  page          SitePage  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([pageId, status])
}

model Funnel {
  id           String             @id @default(uuid()) @db.Uuid
  agencyId     String             @db.Uuid
  subAccountId String             @db.Uuid
  name         String
  description  String?
  domain       String?
  favicon      String?
  status       String             @default("draft")
  type         String             @default("funnel")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  subAccount   SubAccount         @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  pages        FunnelPage[]
  submissions  FunnelSubmission[]

  @@index([agencyId, subAccountId])
}

model FunnelPage {
  id          String             @id @default(uuid()) @db.Uuid
  funnelId    String             @db.Uuid
  name        String
  pathSlug    String
  order       Int                @default(0)
  type        String             @default("sales")
  content     Json?
  visits      Int                @default(0)
  conversions Int                @default(0)
  splitTest   Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  funnel      Funnel             @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  submissions FunnelSubmission[]

  @@index([funnelId])
}

model FunnelSubmission {
  id        String      @id @default(uuid()) @db.Uuid
  funnelId  String      @db.Uuid
  pageId    String?     @db.Uuid
  contactId String?     @db.Uuid
  data      Json
  sourceUrl String?
  ipAddress String?
  createdAt DateTime    @default(now())
  funnel    Funnel      @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  page      FunnelPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([funnelId])
  @@index([pageId])
}

model SiteForm {
  id           String           @id @default(uuid()) @db.Uuid
  agencyId     String           @db.Uuid
  subAccountId String           @db.Uuid
  name         String
  fields       Json             @default("[]")
  settings     Json             @default("{}")
  status       String           @default("active")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  subAccount   SubAccount       @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  submissions  FormSubmission[]

  @@index([agencyId, subAccountId])
}

model FormSubmission {
  id        String   @id @default(uuid()) @db.Uuid
  formId    String   @db.Uuid
  contactId String?  @db.Uuid
  data      Json
  ipAddress String?
  createdAt DateTime @default(now())
  form      SiteForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}

model Survey {
  id           String           @id @default(uuid()) @db.Uuid
  agencyId     String           @db.Uuid
  subAccountId String           @db.Uuid
  name         String
  questions    Json             @default("[]")
  settings     Json             @default("{}")
  status       String           @default("active")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  subAccount   SubAccount       @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  responses    SurveyResponse[]

  @@index([agencyId, subAccountId])
}

model SurveyResponse {
  id        String   @id @default(uuid()) @db.Uuid
  surveyId  String   @db.Uuid
  contactId String?  @db.Uuid
  answers   Json
  ipAddress String?
  createdAt DateTime @default(now())
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
}

model BlogPost {
  id           String     @id @default(uuid()) @db.Uuid
  agencyId     String     @db.Uuid
  subAccountId String     @db.Uuid
  siteId       String?    @db.Uuid
  title        String
  slug         String
  content      String?    @db.Text
  excerpt      String?
  author       String?
  category     String?
  tags         String[]   @default([])
  coverImage   String?
  status       String     @default("draft")
  publishedAt  DateTime?
  seoTitle     String?
  seoDesc      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  subAccount   SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)

  @@index([agencyId, subAccountId])
  @@index([siteId])
}

model MarketingCampaign {
  id           String     @id @default(uuid()) @db.Uuid
  agencyId     String     @db.Uuid
  subAccountId String     @db.Uuid
  name         String
  channel      String
  status       String     @default("draft")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  subAccount   SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)

  @@index([agencyId, subAccountId])
}

model PhoneNumber {
  id           String     @id @default(uuid()) @db.Uuid
  agencyId     String     @db.Uuid
  subAccountId String     @db.Uuid
  number       String
  provider     String?
  capability   String     @default("sms_voice")
  status       String     @default("reserved")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  subAccount   SubAccount @relation(fields: [subAccountId], references: [id], onDelete: Cascade)

  @@unique([provider, number])
  @@index([agencyId, subAccountId])
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  agencyId    String      @db.Uuid
  actorUserId String?     @db.Uuid
  action      AuditAction
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime    @default(now())
  agency      Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  actor       User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([agencyId, createdAt])
  @@index([actorUserId])
}
