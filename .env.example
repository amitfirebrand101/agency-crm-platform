# Supabase Postgres
# Use transaction pooler URL for DATABASE_URL (port 6543, pgbouncer=true)
# If your password contains @ encode it as %40
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
# Direct connection for migrations (port 5432)
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.qraauvmmomiepojmodhh.supabase.co:5432/postgres?sslmode=require"

AUTH_DISABLED="false"

NEXT_PUBLIC_APP_NAME="GoLowLevel"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://qraauvmmomiepojmodhh.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SECRET_KEY="your-server-only-supabase-secret-key"

# Cron protection — set this in Vercel env vars and pass as Authorization: Bearer <secret>
# Vercel Cron does this automatically if CRON_SECRET is set in project settings.
# Generate: openssl rand -hex 32
CRON_SECRET="your-cron-secret-here"

# Provider integrations (steps report SKIPPED with clear message if absent)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
